{
  "appId": "com.process.gpt",
  "appName": "Process-GPT Live",
  "webDir": "../process-gpt-vue3/mobile-live/shell",
  "server": {
    "url": "https://process-gpt.io",
    "allowNavigation": [
      "process-gpt.io",
      "*.process-gpt.io"
    ],
    "errorPath": "index.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "loggingBehavior": "production"
}
